{
  "installCommand": "npm install && npm --prefix excel-addin install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/excel", "destination": "/excel/index.html" },
    { "source": "/excel/", "destination": "/excel/index.html" },
    {
      "source": "/((?!excel/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!excel/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/Jobber-Calculator.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Jobber-Calculator.xml\""
        }
      ]
    },
    {
      "source": "/excel/Jobber-Calculator.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Jobber-Calculator.xml\""
        }
      ]
    }
  ]
}
